# ==============================================================================
# Ticketing CRM — Environment Variables (example)
# Copy to `.env` and fill real values. NEVER commit `.env` (it is gitignored).
# Generate strong secrets with:  openssl rand -hex 64
# ==============================================================================

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
NEST_PORT=4000

# --- Database (PostgreSQL) --------------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB?schema=public
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5445/abch_db?schema=public&connection_limit=20&pool_timeout=30&connect_timeout=10

# Used by docker-compose to provision the postgres container (compose reads these).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=abch_db

# --- Redis (BullMQ queues + Socket.IO adapter + rate limiting) -------------
# The application reads REDIS_URL. (REDIS_HOST/REDIS_PORT alone are NOT used.)
REDIS_URL=redis://localhost:9396

# --- JWT secrets (REQUIRED — app refuses to boot if missing) ---------------
# Use 64+ random chars each. Rotate on any suspected exposure.
JWT_ACCESS_SECRET=CHANGE_ME_64_CHARS_MIN
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_64_CHARS_MIN

# --- CSRF (REQUIRED — app refuses to boot if missing) ----------------------
CSRF_SECRET=CHANGE_ME_32_CHARS_MIN

# --- Frontend origin (REQUIRED — used for CORS + CSP + Socket.IO) ----------
# In production set to the real app origin, e.g. https://app.your-domain.com
FRONTEND_URL=http://localhost:5173

# --- Web Push (OPTIONAL — push notifications disabled if unset) ------------
# Generate with:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:admin@your-domain.com
