generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Connection pool tuning is done via DATABASE_URL query params:
  // ?connection_limit=20&pool_timeout=30&connect_timeout=10
}

// ---------------------------------------------------------------------------
// Enums — previously plain String fields with no DB-level constraint.
// Values match exactly what workflow.constants.ts and application code use.
// ---------------------------------------------------------------------------

enum TicketStatus {
  pending
  open
  in_progress
  on_hold
  resolved
  closed

  @@map("ticket_status")
}

enum TicketPriority {
  low
  normal
  high
  critical

  @@map("ticket_priority")
}

enum UserRole {
  super_admin
  supervisor
  agent
  end_user

  @@map("user_role")
}

enum DeptType {
  SENDER_ONLY
  RECEIVER_ONLY
  BOTH

  @@map("dept_type_enum")
}

enum HoldingStatus {
  internal
  external

  @@map("holding_status_enum")
}

model DeptPermissions {
  id                     Int          @id @default(autoincrement())
  canReceiveTickets      Boolean      @default(true) @map("can_receive_tickets")
  canSendTickets         Boolean      @default(false) @map("can_send_tickets")
  canViewAllDeptTickets  Boolean      @default(true) @map("can_view_all_dept_tickets")
  canAssignTickets       Boolean      @default(true) @map("can_assign_tickets")
  canChangeStatus        Boolean      @default(true) @map("can_change_status")
  canTransferTickets     Boolean      @default(true) @map("can_transfer_tickets")
  canArchiveTickets      Boolean      @default(false) @map("can_archive_tickets")
  canExportData          Boolean      @default(false) @map("can_export_data")
  canViewAnalytics       Boolean      @default(false) @map("can_view_analytics")
  canManageTeamNotes     Boolean      @default(true) @map("can_manage_team_notes")
  canManageDeptUsers     Boolean      @default(false) @map("can_manage_dept_users")
  canViewAuditLogs       Boolean      @default(false) @map("can_view_audit_logs")
  canManageKnowledgeBase Boolean      @default(false) @map("can_manage_knowledge_base")
  departments            Department[]

  @@map("dept_permissions")
}

model Building {
  id        Int      @id @default(autoincrement())
  nameAr    String   @map("name_ar")
  nameEn    String   @map("name_en")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  floors    Floor[]
  tickets   Ticket[]

  @@map("buildings")
}

model Floor {
  id         Int      @id @default(autoincrement())
  nameAr     String   @map("name_ar")
  nameEn     String   @map("name_en")
  buildingId Int      @map("building_id")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  tickets    Ticket[]

  @@unique([buildingId, nameAr])
  @@map("floors")
}

model Department {
  id                     Int                     @id @default(autoincrement())
  nameAr                 String                  @map("name_ar")
  nameEn                 String                  @map("name_en")
  descriptionAr          String?                 @map("description_ar")
  descriptionEn          String?                 @map("description_en")
  deptType               DeptType                @default(RECEIVER_ONLY) @map("dept_type")
  defaultPermissionsId   Int                     @map("default_permissions_id")
  slaHours               Int                     @default(24) @map("sla_hours")
  isActive               Boolean                 @default(true) @map("is_active")
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")
  deletedAt              DateTime?               @map("deleted_at")
  auditLogs              AuditLog[]
  defaultPermissions     DeptPermissions         @relation(fields: [defaultPermissionsId], references: [id])
  allowedTransferSources DeptTransferAllowlist[] @relation("TargetDept")
  allowedTransferTargets DeptTransferAllowlist[] @relation("SourceDept")
  exports                ExportHistory[]
  teamNotes              TeamNote[]
  transfersTo            TicketTransfer[]        @relation("TransferTo")
  transfersFrom          TicketTransfer[]        @relation("TransferFrom")
  ticketTypes            TicketType[]
  ticketsIn              Ticket[]                @relation("TicketDepartment")
  users                  User[]
  assets                 Asset[]

  @@map("departments")
}

model DeptTransferAllowlist {
  id           Int        @id @default(autoincrement())
  sourceDeptId Int        @map("source_dept_id")
  targetDeptId Int        @map("target_dept_id")
  isActive     Boolean    @default(true) @map("is_active")
  createdAt    DateTime   @default(now()) @map("created_at")
  targetDept   Department @relation("TargetDept", fields: [targetDeptId], references: [id])
  sourceDept   Department @relation("SourceDept", fields: [sourceDeptId], references: [id])

  @@unique([sourceDeptId, targetDeptId])
  @@map("dept_transfer_allowlist")
}

model User {
  id                  Int                     @id @default(autoincrement())
  badgeNumber         String                  @unique @map("badge_number")
  username            String                  @unique
  email               String?                 @unique
  passwordHash        String                  @map("password_hash")
  fullNameAr          String                  @map("full_name_ar")
  fullNameEn          String?                 @map("full_name_en")
  role                UserRole                @default(end_user)
  departmentId        Int?                    @map("department_id")
  avatarUrl           String?                 @map("avatar_url")
  about               String?                 @map("about")
  langPref            String                  @default("ar") @map("lang_pref")
  isActive            Boolean                 @default(true) @map("is_active")
  forcePasswordChange Boolean                 @default(false) @map("force_password_change")
  lastLoginAt         DateTime?               @map("last_login_at")
  lastLoginIp         String?                 @map("last_login_ip")
  failedLoginAttempts Int                     @default(0) @map("failed_login_attempts")
  lockUntil           DateTime?               @map("lock_until")
  createdAt           DateTime                @default(now()) @map("created_at")
  updatedAt           DateTime                @updatedAt @map("updated_at")
  deletedAt           DateTime?               @map("deleted_at")
  auditLogs           AuditLog[]
  exports             ExportHistory[]
  notifications       Notification[]
  pushSubs            PushSubscription[]
  teamNotes           TeamNote[]
  messages            TicketMessage[]
  statusHistory       TicketStatusHistory[]
  transfers           TicketTransfer[]
  teamNoteComments    TeamNoteComment[]
  teamNoteLikes       TeamNoteLike[]
  ticketsArchived     Ticket[]                @relation("TicketArchiver")
  ticketsAssigned     Ticket[]                @relation("TicketAssignee")
  ticketsCreated      Ticket[]                @relation("TicketCreator")
  knowledgeArticles   KnowledgeArticle[]
  permissionsOverride UserPermissionOverride?
  department          Department?             @relation(fields: [departmentId], references: [id])

  @@map("users")
}

model UserPermissionOverride {
  id                     Int      @id @default(autoincrement())
  userId                 Int      @unique @map("user_id")
  canReceiveTickets      Boolean? @map("can_receive_tickets")
  canSendTickets         Boolean? @map("can_send_tickets")
  canViewAllDeptTickets  Boolean? @map("can_view_all_dept_tickets")
  canAssignTickets       Boolean? @map("can_assign_tickets")
  canChangeStatus        Boolean? @map("can_change_status")
  canTransferTickets     Boolean? @map("can_transfer_tickets")
  canArchiveTickets      Boolean? @map("can_archive_tickets")
  canExportData          Boolean? @map("can_export_data")
  canViewAnalytics       Boolean? @map("can_view_analytics")
  canManageTeamNotes     Boolean? @map("can_manage_team_notes")
  canManageDeptUsers     Boolean? @map("can_manage_dept_users")
  canViewAuditLogs       Boolean? @map("can_view_audit_logs")
  canManageKnowledgeBase Boolean? @map("can_manage_knowledge_base")
  /// Array of department IDs the user is allowed to transfer tickets to.
  /// Stored as a native JSON array; replaces the previous serialised String.
  allowedTransferDeptIds Json?    @map("allowed_transfer_dept_ids")
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_permission_overrides")
}

model TicketType {
  id           Int         @id @default(autoincrement())
  nameAr       String      @map("name_ar")
  nameEn       String      @map("name_en")
  departmentId Int?        @map("department_id")
  color        String      @default("#6B7280")
  slaHours     Int?        @map("sla_hours")
  isActive     Boolean     @default(true) @map("is_active")
  displayOrder Int         @default(0) @map("display_order")
  createdAt    DateTime    @default(now()) @map("created_at")
  department   Department? @relation(fields: [departmentId], references: [id])
  tickets      Ticket[]

  @@map("ticket_types")
}

model Ticket {
  id                       Int                   @id @default(autoincrement())
  ticketNumber             String                @unique @map("ticket_number")
  subject                  String?
  createdById              Int                   @map("created_by")
  creatorName              String                @map("creator_name")
  creatorPhone             String?               @map("creator_phone")
  creatorExtension         String?               @map("creator_extension")
  creatorDeptId            Int?                  @map("creator_dept_id")
  creatorDeptName          String?               @map("creator_dept_name")
  buildingId               Int?                  @map("building_id")
  buildingName             String?               @map("building_name")
  floorId                  Int?                  @map("floor_id")
  floorName                String?               @map("floor_name")
  roomExtension            String?               @map("room_extension")
  description              String
  departmentId             Int                   @map("department_id")
  assignedToId             Int?                  @map("assigned_to")
  ticketTypeId             Int?                  @map("ticket_type_id")
  status                   TicketStatus          @default(pending)
  priority                 TicketPriority        @default(normal)
  holdingStatus            HoldingStatus         @default(internal) @map("holding_status")
  slaDeadline              DateTime?             @map("sla_deadline")
  slaWarningSent           Boolean               @default(false) @map("sla_warning_sent")
  slaBreachSent            Boolean               @default(false) @map("sla_breach_sent")
  dueDate                  DateTime?             @map("due_date")
  /// Related ticket IDs as a native JSON array.
  /// Previously stored as a hand-serialised JSON string — now JSONB for
  /// safe querying and type safety. Read sites no longer need JSON.parse().
  relatedTickets           Json?                 @map("related_tickets")
  currentQueueEntryAt      DateTime              @default(now()) @map("current_queue_entry_at")
  firstResponseAt          DateTime?             @map("first_response_at")
  completedAt              DateTime?             @map("completed_at")
  closedAt                 DateTime?             @map("closed_at")
  requiresExternalResource Boolean               @default(false) @map("requires_external_resource")
  externalResourceCost     Float?                @map("external_resource_cost")
  externalResourceNote     String?               @map("external_resource_note")
  isArchived               Boolean               @default(false) @map("is_archived")
  archivedAt               DateTime?             @map("archived_at")
  archivedById             Int?                  @map("archived_by")
  rating                   Int?
  feedback                 String?
  assetId                  Int?                  @map("asset_id")
  createdAt                DateTime              @default(now()) @map("created_at")
  updatedAt                DateTime              @updatedAt @map("updated_at")
  deletedAt                DateTime?             @map("deleted_at")
  auditLogs                AuditLog[]
  notifications            Notification[]
  attachments              TicketAttachment[]
  messages                 TicketMessage[]
  statusHistory            TicketStatusHistory[]
  transfers                TicketTransfer[]
  asset                    Asset?                @relation(fields: [assetId], references: [id])
  floor                    Floor?                @relation(fields: [floorId], references: [id])
  building                 Building?             @relation(fields: [buildingId], references: [id])
  ticketType               TicketType?           @relation(fields: [ticketTypeId], references: [id])
  archivedBy               User?                 @relation("TicketArchiver", fields: [archivedById], references: [id])
  assignedTo               User?                 @relation("TicketAssignee", fields: [assignedToId], references: [id])
  department               Department            @relation("TicketDepartment", fields: [departmentId], references: [id])
  createdBy                User                  @relation("TicketCreator", fields: [createdById], references: [id])

  @@index([status, createdAt])
  @@index([departmentId, status])
  @@index([assignedToId, status])
  @@index([isArchived])
  @@index([createdById])
  @@index([ticketTypeId])
  @@index([slaDeadline]) // SLA cron job scans every 5 min
  @@index([departmentId, createdAt]) // Date-filtered dept queries
  @@index([departmentId, isArchived, status]) // Inbox compound filter pattern
  @@map("tickets")
}

model TicketAttachment {
  id            Int      @id @default(autoincrement())
  ticketId      Int      @map("ticket_id")
  uploadedById  Int      @map("uploaded_by")
  fileName      String   @map("file_name")
  fileUrl       String   @map("file_url")
  fileSize      BigInt?  @map("file_size")
  mimeType      String?  @map("mime_type")
  isVoiceNote   Boolean  @default(false) @map("is_voice_note")
  voiceDuration Int?     @map("voice_duration")
  createdAt     DateTime @default(now()) @map("created_at")
  ticket        Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("ticket_attachments")
}

model TicketMessage {
  id            Int                 @id @default(autoincrement())
  ticketId      Int                 @map("ticket_id")
  senderId      Int                 @map("sender_id")
  messageType   String              @default("public") @map("message_type")
  body          String?
  voiceUrl      String?             @map("voice_url")
  voiceDuration Int?                @map("voice_duration")
  isRead        Boolean             @default(false) @map("is_read")
  createdAt     DateTime            @default(now()) @map("created_at")
  deletedAt     DateTime?           @map("deleted_at")
  attachments   MessageAttachment[]
  sender        User                @relation(fields: [senderId], references: [id])
  ticket        Ticket              @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("ticket_messages")
}

model MessageAttachment {
  id            Int           @id @default(autoincrement())
  messageId     Int           @map("message_id")
  uploadedById  Int           @map("uploaded_by")
  fileName      String        @map("file_name")
  fileUrl       String        @map("file_url")
  fileSize      BigInt?       @map("file_size")
  mimeType      String?       @map("mime_type")
  isVoiceNote   Boolean       @default(false) @map("is_voice_note")
  voiceDuration Int?          @map("voice_duration")
  createdAt     DateTime      @default(now()) @map("created_at")
  message       TicketMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@map("message_attachments")
}

model TicketTransfer {
  id               Int        @id @default(autoincrement())
  ticketId         Int        @map("ticket_id")
  transferredById  Int        @map("transferred_by")
  fromDepartmentId Int        @map("from_department_id")
  toDepartmentId   Int        @map("to_department_id")
  reason           String?
  transferredAt    DateTime   @default(now()) @map("transferred_at")
  createdAt        DateTime   @default(now()) @map("created_at")
  toDepartment     Department @relation("TransferTo", fields: [toDepartmentId], references: [id])
  fromDepartment   Department @relation("TransferFrom", fields: [fromDepartmentId], references: [id])
  transferredBy    User       @relation(fields: [transferredById], references: [id])
  ticket           Ticket     @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("ticket_transfers")
}

model TicketStatusHistory {
  id          Int      @id @default(autoincrement())
  ticketId    Int      @map("ticket_id")
  changedById Int      @map("changed_by")
  oldStatus   String?  @map("old_status")
  newStatus   String   @map("new_status")
  note        String?
  createdAt   DateTime @default(now()) @map("created_at")
  changedBy   User     @relation(fields: [changedById], references: [id])
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("ticket_status_history")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  ticketId  Int?     @map("ticket_id")
  eventType String   @map("event_type")
  titleAr   String?  @map("title_ar")
  titleEn   String?  @map("title_en")
  bodyAr    String?  @map("body_ar")
  bodyEn    String?  @map("body_en")
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")
  ticket    Ticket?  @relation(fields: [ticketId], references: [id])
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@index([ticketId])
  @@map("notifications")
}

model TeamNote {
  id           Int                  @id @default(autoincrement())
  departmentId Int?                 @map("department_id")
  authorId     Int                  @map("author_id")
  body         String
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")
  deletedAt    DateTime?            @map("deleted_at")
  attachments  TeamNoteAttachment[]
  comments     TeamNoteComment[]
  likes        TeamNoteLike[]
  author       User                 @relation(fields: [authorId], references: [id])
  department   Department?          @relation(fields: [departmentId], references: [id])

  @@map("team_notes")
}

model TeamNoteComment {
  id        Int      @id @default(autoincrement())
  noteId    Int      @map("note_id")
  authorId  Int      @map("author_id")
  body      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  note      TeamNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id])

  @@map("team_note_comments")
}

model TeamNoteLike {
  id        Int      @id @default(autoincrement())
  noteId    Int      @map("note_id")
  userId    Int      @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  note      TeamNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([noteId, userId])
  @@map("team_note_likes")
}

model TeamNoteAttachment {
  id            Int      @id @default(autoincrement())
  noteId        Int      @map("note_id")
  fileName      String   @map("file_name")
  fileUrl       String   @map("file_url")
  fileSize      BigInt?  @map("file_size")
  mimeType      String?  @map("mime_type")
  isVoiceNote   Boolean  @default(false) @map("is_voice_note")
  voiceDuration Int?     @map("voice_duration")
  createdAt     DateTime @default(now()) @map("created_at")
  note          TeamNote @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@map("team_note_attachments")
}

model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  endpoint  String
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, endpoint])
  @@map("push_subscriptions")
}

model AuditLog {
  id           Int         @id @default(autoincrement())
  userId       Int?        @map("user_id")
  action       String
  entityType   String?     @map("entity_type")
  entityId     Int?        @map("entity_id")
  departmentId Int?        @map("department_id")
  ticketId     Int?        @map("ticket_id")
  oldData      Json?       @map("old_data")
  newData      Json?       @map("new_data")
  ipAddress    String?     @map("ip_address")
  userAgent    String?     @map("user_agent")
  createdAt    DateTime    @default(now()) @map("created_at")
  ticket       Ticket?     @relation(fields: [ticketId], references: [id])
  department   Department? @relation(fields: [departmentId], references: [id])
  user         User?       @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([ticketId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

model SystemSetting {
  key         String   @id
  value       String?
  description String?
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedById Int?     @map("updated_by")

  @@map("system_settings")
}

model ExportHistory {
  id           Int         @id @default(autoincrement())
  exportedById Int         @map("exported_by")
  departmentId Int?        @map("department_id")
  dateFrom     DateTime    @map("date_from")
  dateTo       DateTime    @map("date_to")
  fileName     String      @map("file_name")
  fileUrl      String      @map("file_url")
  fileSize     BigInt?     @map("file_size")
  ticketCount  Int         @default(0) @map("ticket_count")
  createdAt    DateTime    @default(now()) @map("created_at")
  expiresAt    DateTime    @map("expires_at")
  deletedAt    DateTime?   @map("deleted_at")
  department   Department? @relation(fields: [departmentId], references: [id])
  exportedBy   User        @relation(fields: [exportedById], references: [id])

  @@map("export_history")
}

model Asset {
  id             Int         @id @default(autoincrement())
  name           String
  serialNumber   String?     @unique @map("serial_number")
  type           String // e.g., "Medical Device", "IT Hardware"
  location       String?
  departmentId   Int?        @map("department_id")
  status         String      @default("active") // active, maintenance, retired
  purchaseDate   DateTime?   @map("purchase_date")
  warrantyExpiry DateTime?   @map("warranty_expiry")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  deletedAt      DateTime?   @map("deleted_at")
  tickets        Ticket[]
  department     Department? @relation(fields: [departmentId], references: [id])

  @@map("assets")
}

model KnowledgeCategory {
  id        Int                @id @default(autoincrement())
  nameAr    String             @map("name_ar")
  nameEn    String             @map("name_en")
  articles  KnowledgeArticle[]
  createdAt DateTime           @default(now()) @map("created_at")

  @@map("knowledge_categories")
}

model KnowledgeArticle {
  id         Int               @id @default(autoincrement())
  titleAr    String            @map("title_ar")
  titleEn    String            @map("title_en")
  contentAr  String            @map("content_ar")
  contentEn  String            @map("content_en")
  categoryId Int               @map("category_id")
  authorId   Int               @map("author_id")
  views      Int               @default(0)
  isActive   Boolean           @default(true) @map("is_active")
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")
  category   KnowledgeCategory @relation(fields: [categoryId], references: [id])
  author     User              @relation(fields: [authorId], references: [id])

  @@index([categoryId])
  @@index([isActive])
  @@index([views])
  @@map("knowledge_articles")
}

// ---------------------------------------------------------------------------
// SaaS subscription layer
//
// The product was a single-hospital tool: every user shared one deployment with
// no notion of who is paying, for what, or until when. These tables introduce
// the commercial side — plans, an organisation's subscription to one, and an
// invoice trail — so a platform owner can actually sell and administer it.
//
// Multi-tenant data isolation (tagging every table with an organisation) is a
// separate, larger migration; this layer deliberately stands on its own so the
// billing side can be run and reviewed before that lands.
// ---------------------------------------------------------------------------

enum SubscriptionStatus {
  trialing
  active
  past_due
  suspended
  cancelled
  expired
}

enum BillingCycle {
  monthly
  yearly
}

enum InvoiceStatus {
  draft
  issued
  paid
  void
}

model Plan {
  id            Int            @id @default(autoincrement())
  code          String         @unique
  nameAr        String         @map("name_ar")
  nameEn        String         @map("name_en")
  descriptionAr String?        @map("description_ar")
  descriptionEn String?        @map("description_en")
  // Price in the smallest currency unit to avoid floating point money.
  priceMonthly  Int            @default(0) @map("price_monthly")
  priceYearly   Int            @default(0) @map("price_yearly")
  currency      String         @default("EGP")
  // Zero means unlimited, so a plan does not have to enumerate every ceiling.
  maxUsers      Int            @default(0) @map("max_users")
  maxTickets    Int            @default(0) @map("max_tickets_per_month")
  maxStorageMb  Int            @default(0) @map("max_storage_mb")
  features      Json?
  isActive      Boolean        @default(true) @map("is_active")
  sortOrder     Int            @default(0) @map("sort_order")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  subscriptions Subscription[]

  @@index([isActive])
  @@map("plans")
}

model Subscription {
  id               Int                @id @default(autoincrement())
  // One row per customer organisation. Until multi-tenancy lands this holds a
  // single row for the hospital running the deployment.
  organizationName String             @map("organization_name")
  contactEmail     String?            @map("contact_email")
  contactPhone     String?            @map("contact_phone")
  planId           Int                @map("plan_id")
  status           SubscriptionStatus @default(trialing)
  billingCycle     BillingCycle       @default(monthly) @map("billing_cycle")
  startedAt        DateTime           @default(now()) @map("started_at")
  // Null means open-ended; the resolver treats that as "never expires".
  currentPeriodEnd DateTime?          @map("current_period_end")
  trialEndsAt      DateTime?          @map("trial_ends_at")
  cancelledAt      DateTime?          @map("cancelled_at")
  notes            String?
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  plan             Plan               @relation(fields: [planId], references: [id])
  invoices         Invoice[]

  @@index([status])
  @@index([planId])
  @@map("subscriptions")
}

model Invoice {
  id             Int           @id @default(autoincrement())
  subscriptionId Int           @map("subscription_id")
  number         String        @unique
  amount         Int
  currency       String        @default("EGP")
  status         InvoiceStatus @default(issued)
  periodStart    DateTime      @map("period_start")
  periodEnd      DateTime      @map("period_end")
  issuedAt       DateTime      @default(now()) @map("issued_at")
  paidAt         DateTime?     @map("paid_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  subscription   Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([status])
  @@map("invoices")
}
